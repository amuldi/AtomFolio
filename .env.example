# ---------------------------------------------------------------------------------------------
# REQUIRED IN PRODUCTION (Vercel prod + preview deployments). Without these, GET /api/health's
# `readiness.errors` will report the deployment as not production-ready (see
# docs/production-readiness.md) — the app still runs, but silently degrades to guest-only access
# and/or non-durable storage instead of failing loudly, which is exactly the risk this section
# exists to call out before you hit it live. Locally / in tests, none of these are required —
# the app runs happily in guest-only, memory-store mode.
# ---------------------------------------------------------------------------------------------

# Neon Postgres connection string from Vercel Marketplace or Neon console. REQUIRED in production:
# without it the portfolio store silently falls back to per-instance process memory, which does
# not survive a cold start or redeploy. This is the single highest-impact variable in this file.
DATABASE_URL="postgres://user:password@host.neon.tech/neondb?sslmode=require"

# Use Postgres for server-side portfolio persistence.
# Without this value, AtomFolio still uses Postgres automatically when DATABASE_URL exists.
ATOMFOLIO_STORE_DRIVER="postgres"

# Keep enabled for first deploys so the tables are created if they are missing.
# Set to "false" after you manage migrations separately.
ATOMFOLIO_DB_AUTO_MIGRATE="true"


# Clerk secret key (server-side). REQUIRED in production to verify Authorization: Bearer <JWT>
# requests. Without it, resolveAuthContext falls back to guest-only access — every request is
# treated as unauthenticated, so nobody can actually sign in even if the client-side key below is
# set. GET /api/health's readiness.errors reports this as "clerk-secret-missing" in production.
CLERK_SECRET_KEY="sk_test_..."

# Clerk publishable key (client-side, exposed to the browser via Vite's import.meta.env).
# REQUIRED in production. Without it, the client never wraps the app in <ClerkProvider> and
# AuthPanel is not rendered, so the app runs in guest-only mode with no way to sign in at all.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."

# Optional. Support/contact address shown by the account-deletion request entry point in the
# settings panel (src/components/auth/AuthPanel.jsx). Without it, that entry point stays disabled
# and explains that no contact channel is configured yet, rather than pretending to submit a
# request nowhere goes.
VITE_ATOMFOLIO_SUPPORT_EMAIL=""

# Optional, local development only. Trust x-atomfolio-user-* headers instead of a verified
# Clerk token. Force-disabled whenever VERCEL=1, regardless of this value, so it can never be
# used to spoof identity in production.
ATOMFOLIO_TRUSTED_AUTH_HEADERS="false"

# Optional. Rate limit driver — "memory" (default) or "redis". "redis" requires also setting
# ATOMFOLIO_REDIS_URL (or UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN) — this repo does not
# ship an actual Redis client, selecting "redis" without a connection just logs a warning and
# keeps using in-memory limiting underneath. See server/rateLimit.mjs and
# docs/production-readiness.md for recommended production values.
ATOMFOLIO_RATE_LIMIT_DRIVER="memory"

# Finnhub API key (server-side only, see server/finnhubNews.mjs). Sign up at
# https://finnhub.io/register to get one — this repo never signs up on your behalf. Without it,
# foreign-holding/English-language market news falls back to the existing Bing RSS scrape.
FINNHUB_API_KEY=""

# Broker credential encryption key (server-side only, see server/secretCrypto.mjs). Base64-encoded,
# must decode to exactly 32 bytes (AES-256-GCM). Generate one with: openssl rand -base64 32
# Without it, broker credentials (KIS app key/secret) cannot be encrypted or decrypted at all —
# there is no fallback, by design, since storing them unencrypted is not an option.
ATOMFOLIO_BROKER_ENCRYPTION_KEY=""

# 한국투자증권(KIS) Open API 앱 키/시크릿 (서버 전용, see server/marketData/kisProvider.mjs).
# 발급: apiportal.koreainvestment.com 에서 회원가입 후 "마이 앱" 메뉴에서 앱 등록하면 발급됨.
# 실전투자 계좌 없이도 모의투자(가상 매매) 앱으로 등록해 키를 받을 수 있음 — 이 경우
# KIS_APP_BASE_URL을 모의투자 도메인으로 바꿔야 함(아래 참고).
# 둘 중 하나라도 비어 있으면 국내 종목 시세 조회는 KIS를 건너뛰고 기존 폴백(네이버/야후/Stooq)
# 으로 자동 전환됨 — 앱이 지금처럼 정상 동작하는 데 이 값이 꼭 필요하지는 않음.
KIS_APP_KEY=""
KIS_APP_SECRET=""

# 실전투자: https://openapi.koreainvestment.com:9443 (기본값, 비워두면 이 값 사용)
# 모의투자(샌드박스): https://openapivts.koreainvestment.com:29443
KIS_APP_BASE_URL=""

# Optional. Slack (or any Slack-compatible) incoming webhook URL — when set, server/alerting.mjs
# posts a message here whenever every live-quote provider fails at once (see
# server/marketDataCache.mjs). Without it, alerts are still recorded via recordOperationalEvent
# and visible at /api/health?details=events, just without a push notification. Free to leave
# empty; free to set up (Slack's "Incoming Webhooks" app has no paid tier).
ATOMFOLIO_ALERT_WEBHOOK_URL=""

# Optional, client-side (see src/lib/analytics.js). Cookie-free, no-personal-data usage analytics
# via Plausible — unset by default, so nothing is ever loaded/tracked without deliberately
# pointing this at a real domain registered on plausible.io (or a self-hosted instance, via
# VITE_PLAUSIBLE_SCRIPT_SRC below).
VITE_PLAUSIBLE_DOMAIN=""
# Only needed for a self-hosted Plausible instance — defaults to https://plausible.io/js/script.js
VITE_PLAUSIBLE_SCRIPT_SRC=""

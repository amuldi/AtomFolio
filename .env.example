# Neon Postgres connection string from Vercel Marketplace or Neon console.
DATABASE_URL="postgres://user:password@host.neon.tech/neondb?sslmode=require"

# Use Postgres for server-side portfolio persistence.
# Without this value, AtomFolio still uses Postgres automatically when DATABASE_URL exists.
ATOMFOLIO_STORE_DRIVER="postgres"

# Keep enabled for first deploys so the tables are created if they are missing.
# Set to "false" after you manage migrations separately.
ATOMFOLIO_DB_AUTO_MIGRATE="true"

# Optional. Enables server-side AI portfolio summaries.
# When omitted, AtomFolio returns deterministic metric-based summaries.
OPENAI_API_KEY="sk-..."

# Clerk secret key (server-side). Required to verify Authorization: Bearer <JWT> requests.
# Without it, resolveAuthContext falls back to guest-only access in every environment.
CLERK_SECRET_KEY="sk_test_..."

# Clerk publishable key (client-side, exposed to the browser via Vite's import.meta.env).
# Without it, the client never wraps the app in <ClerkProvider> and AuthPanel is not rendered,
# so the app runs in guest-only mode.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."

# Optional, local development only. Trust x-atomfolio-user-* headers instead of a verified
# Clerk token. Force-disabled whenever VERCEL=1, regardless of this value, so it can never be
# used to spoof identity in production.
ATOMFOLIO_TRUSTED_AUTH_HEADERS="false"

# Finnhub API key (server-side only, see server/finnhubNews.mjs). Sign up at
# https://finnhub.io/register to get one — this repo never signs up on your behalf. Without it,
# foreign-holding/English-language market news falls back to the existing Bing RSS scrape.
FINNHUB_API_KEY=""
